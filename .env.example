# Copy to .env.local and fill in. Never commit a real .env file.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database + Auth (Supabase) ---
# Pooled connection string for Drizzle.
# Supabase pooler, SESSION mode — port 5432 on the pooler host, not 6543.
# Transaction mode (6543) hands statements between backends mid-exchange and
# crosses parameters between queries under this app's load — measured at 9 of
# 14 homepage requests failing. Session mode doesn't have that bug, but a
# separate lock-ordering bug in pickWinner (fixed, see ISSUES.md § 2026-09-12)
# held row locks for a transaction's full lifetime under session mode,
# because session mode has no per-transaction connection reset to mask it.
# Both bugs are now understood; only the pickWinner fix is deployed-and-proven
# so far. Keep the port as written.
DATABASE_URL="postgresql://postgres.<ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct connection, used for migrations only. NOTE: the db.<ref>.supabase.co
# host no longer resolves for this project (ENOTFOUND), so migrations need a
# working value here before `npm run db:migrate` will run.
DIRECT_URL="postgresql://postgres:password@host:5432/postgres?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments (Dodo Payments) ---
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
# "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Pre-created, fixed-price Products in the Dodo dashboard. See ARCHITECTURE.md
# § Payments — the amount is still sent explicitly on the line item.
DODO_PAYMENTS_SUBMISSION_PRODUCT_ID=""
DODO_PAYMENTS_SPONSOR_PRODUCT_ID=""

# --- Image storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Email (Resend) ---
RESEND_API_KEY=""
