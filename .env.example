# Copy to .env.local and fill in. Never commit a real .env file.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database + Auth (Supabase) ---
# Pooled connection string for Drizzle.
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?sslmode=require"
# Direct connection, used for migrations only.
DIRECT_URL="postgresql://postgres:password@host:5432/postgres?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments (Dodo Payments) ---
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
# "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# A pre-created Product in the Dodo dashboard with "pay what you want"
# pricing enabled (min $1) — the submission fee references it and overrides
# the amount per checkout. See ARCHITECTURE.md § Payments.
DODO_PAYMENTS_SUBMISSION_PRODUCT_ID=""

# --- Image storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Email (Resend) ---
RESEND_API_KEY=""
