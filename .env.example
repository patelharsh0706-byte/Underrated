# Copy to .env.local and fill in. Never commit a real .env file.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database + Auth (Supabase) ---
# Pooled connection string for Drizzle.
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?sslmode=require"
# Direct connection, used for migrations only.
DIRECT_URL="postgresql://postgres:password@host:5432/postgres?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SPOTLIGHT_PRICE_ID=""

# --- Image storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Email (Resend) ---
RESEND_API_KEY=""
